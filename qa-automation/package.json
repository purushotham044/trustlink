{
  "name": "trustlink-qa-automation",
  "version": "2.0.0",
  "description": "TrustLink Enterprise QA Automation, Appium 2.x, Selenium, k6 Load & Security Testing Ecosystem",
  "main": "index.js",
  "scripts": {
    "test:mobile": "mocha \"mobile/tests/**/*.spec.js\" --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/mobile,reportFilename=index",
    "test:web": "mocha \"web/tests/**/*.spec.js\" --timeout 90000 --reporter mochawesome --reporter-options reportDir=reports/web,reportFilename=index",
    "test:security": "mocha \"security/tests/**/*.spec.js\" --timeout 60000",
    "test:ai-discovery": "node ai-discovery/discover-tests.js",
    "test:load": "k6 run load/k6-suite.js",
    "generate:report": "node utils/reportMerger.js"
  },
  "dependencies": {
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "appium-xcuitest-driver": "^7.20.0",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "ethers": "^6.11.1",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.20.0",
    "webdriverio": "^8.36.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "chromedriver": "^124.0.0",
    "geckodriver": "^4.4.0"
  }
}
