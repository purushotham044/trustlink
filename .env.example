# TrustLink Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ── SAFE FOR CLIENT ─────────────────────────────────────────
# Supabase project URL (found in Supabase dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (found in Supabase dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJYOUR_ANON_KEY_HERE

# ── BACKEND / EDGE FUNCTION SECRETS (never put these in .env for the app) ─────
# These are set via: supabase secrets set KEY=value
# They are NEVER placed in this file or in React Native source code.
#
# SUPABASE_SERVICE_ROLE_KEY      → Supabase dashboard → Settings → API
# BLOCKCHAIN_RPC_URL             → Alchemy/Infura Sepolia endpoint
# BLOCKCHAIN_PRIVATE_KEY         → Backend-only wallet private key
# CONTRACT_ADDRESS               → Deployed TrustLinkAnchor contract address
# BLOCKCHAIN_NETWORK             → sepolia | polygon | mainnet
